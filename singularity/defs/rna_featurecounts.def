Bootstrap: docker
From: condaforge/mambaforge:latest

%files
    ../../env_config/rna_featurecounts.yaml /env.yaml

%post
    mamba env create -f /env.yaml -n rna_featurecounts
    mamba clean --all -y

%environment
    export PATH="/opt/conda/envs/rna_featurecounts/bin:$PATH"

%runscript
    exec "$@"