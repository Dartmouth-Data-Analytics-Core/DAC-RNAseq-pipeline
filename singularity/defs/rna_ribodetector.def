Bootstrap: docker
From: condaforge/mambaforge:latest

%files
    ../../env_config/rna_ribodetector.yaml /env.yaml

%post
    mamba env create -f /env.yaml -n rna_ribodetector
    mamba clean --all -y

%environment
    export PATH="/opt/conda/envs/rna_ribodetector/bin:$PATH"

%runscript
    exec "$@"